# --- CORE AI ENGINE ---
# Required for the agent's reasoning, vision analysis, and embeddings.
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# --- AI CONFIGURATION ---
# Model selection: e.g., 'gemini-2.0-flash' or 'gemini-1.5-pro'
AI_MODEL=gemini-2.0-flash
TEMPERATURE=0.2

# --- EXTERNAL DATA APIs ---
# Weather API: Essential for Cross-Tool Verification (preventing chemical runoff)
# Recommended: OpenWeatherMap or Tomorrow.io
WEATHER_API_KEY=your_weather_api_key_here

# Market Data API: Used for global commodity benchmarks
# Recommended: Alpha Vantage or Nasdaq Data Link
MARKET_API_KEY=your_market_api_key_here

# --- DATABASE CONFIGURATION ---
# Local SQLite database path (default)
DATABASE_URL=sqlite:///./farmplan.db

# --- APP SETTINGS ---
# Logging level: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
# Environment: development, production
ENVIRONMENT=development
